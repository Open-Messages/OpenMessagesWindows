<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon for the tray. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build (not run) on macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>OpenMessages</AssemblyName>
    <RootNamespace>OpenMessages.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms both define these; prefer WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <ProjectReference Include="..\OpenMessages.Core\OpenMessages.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="firebase-config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('firebase-config.json')" />
  </ItemGroup>
</Project>
